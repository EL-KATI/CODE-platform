# Copy this file to .env and fill in your keys (loaded automatically by the server at start-up)
# Leave a key empty if you don't have it. Monitor AI needs at least one of the two.

# Claude (Anthropic) - https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Monitor AI: models (optional, defaults shown)
# ANTHROPIC_MODEL=claude-opus-5-5
# GEMINI_MODEL=gemini-3.8-flash   (اختياري — بدونه يختار الخادم نموذجاً متاحاً تلقائياً)

# Google OAuth (Sign-In with Google) - https://console.cloud.google.com
# 1) أنشئ مشروعاً → APIs & Services → Credentials → OAuth 2.0 Client ID
# 2) Type: Web application
# 3) Authorized redirect URIs: https://your-domain.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://81b3q0vt-3000.uks1.devtunnels.ms/auth/google/callback

# SMTP للإيميل (مطلوب لـ 2FA الأدمن) ─────────────────────────────────────────
# Gmail: قم بتفعيل "App Password" من إعدادات الحساب → أمان → كلمات مرور التطبيقات
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password-here
# SMTP_FROM="منصة CODE" <your-email@gmail.com>  (اختياري)

# JWT secret (change this in production)
JWT_SECRET=change-me-in-production

# Server port
PORT=3000
